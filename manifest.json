{
  "manifest_version": 3,
  "name": "PromptVault - AI提示词管理助手",
  "version": "1.1.0",
  "description": "保存、整理和快速访问你的 AI 提示词 | Save, organize, and quickly access your AI prompts",
  "permissions": [
    "storage",
    "contextMenus",
    "notifications"
  ],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "i18n.js",
        "storage.js",
        "universal-insert.js",
        "content.js",
        "sidebar.js",
        "command-palette.js"
      ],
      "run_at": "document_end"
    }
  ],
  "commands": {
    "open-command-palette": {
      "suggested_key": {
        "default": "Ctrl+Shift+P",
        "mac": "MacCtrl+Shift+P"
      },
      "description": "Open PromptVault Command Palette"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "sidebar.css",
        "sidebar-frame.html",
        "sidebar-frame.js",
        "i18n.js",
        "storage.js",
        "styles.css",
        "welcome.html",
        "welcome.js",
        "welcome.css",
        "assets/support/wechat-reward.png",
        "icons/icon16.png",
        "icons/icon48.png",
        "icons/icon128.png"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
